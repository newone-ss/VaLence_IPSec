# Public URL of the backend API, provided by the deployment environment.
VITE_API_BASE_URL=

# Optional absolute Server-Sent Events URL, provided by the backend deployment.
VITE_SSE_URL=

# Identity provider configuration. Authentication flow integration requires backend contract details.
VITE_AUTH_ISSUER=
VITE_AUTH_CLIENT_ID=

# Human-readable deployment environment label, e.g. Staging or Production.
VITE_ENVIRONMENT=
